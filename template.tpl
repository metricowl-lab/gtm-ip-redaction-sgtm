___TESTS___

scenarios:
- name: Always redacts by default
  code: |-
    mock('getAnonymizedIpAddress', '198.51.100.0');
    mock('getEventData', '198.51.100.42');
    assertThat(runCode({mode: 'always'})).isEqualTo('198.51.100.0');
    assertApi('getEventData').wasNotCalled();
- name: Full address when consent is granted
  code: |-
    mock('getAnonymizedIpAddress', '198.51.100.0');
    mock('getEventData', '198.51.100.42');
    assertThat(runCode({mode: 'consent', consentValue: 'granted'})).isEqualTo('198.51.100.42');
    assertApi('getEventData').wasCalledWith('ip_override');
- name: Consent values are case-insensitive and accept true and 1
  code: |-
    mock('getAnonymizedIpAddress', '198.51.100.0');
    mock('getEventData', '198.51.100.42');
    assertThat(runCode({mode: 'consent', consentValue: 'TRUE'})).isEqualTo('198.51.100.42');
    assertThat(runCode({mode: 'consent', consentValue: 1})).isEqualTo('198.51.100.42');
- name: Redacts when consent is denied or missing
  code: |-
    mock('getAnonymizedIpAddress', '198.51.100.0');
    mock('getEventData', '198.51.100.42');
    assertThat(runCode({mode: 'consent', consentValue: 'denied'})).isEqualTo('198.51.100.0');
    assertThat(runCode({mode: 'consent', consentValue: undefined})).isEqualTo('198.51.100.0');
- name: Redacts when consent is granted but there is no address to pass on
  code: |-
    mock('getAnonymizedIpAddress', '2001:db8:85a3::');
    mock('getEventData', undefined);
    assertThat(runCode({mode: 'consent', consentValue: 'granted'})).isEqualTo('2001:db8:85a3::');



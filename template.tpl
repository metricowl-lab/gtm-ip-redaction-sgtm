___SANDBOXED_JS_FOR_SERVER___

const getAnonymizedIpAddress = require('getAnonymizedIpAddress');
const getEventData = require('getEventData');
const makeString = require('makeString');

// Full IP address only with advertising consent, and only if the client supplied one.
if (data.mode === 'consent') {
  const consent = makeString(data.consentValue).toLowerCase();
  if (consent === 'granted' || consent === 'true' || consent === '1') {
    const fullIp = getEventData('ip_override');
    if (fullIp) return fullIp;
  }
}

// IPv4: last octet set to 0. IPv6: last 80 bits set to zero. '::' if the address can't be read.
return getAnonymizedIpAddress();


